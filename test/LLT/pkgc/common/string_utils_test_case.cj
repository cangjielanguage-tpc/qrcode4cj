    @TestCase
    public func testShortShiftJIS1(): Unit {
        // 金魚
        doTest([UInt8(0x8b), UInt8(0xe0), UInt8(0x8b), UInt8(0x9b)], StringUtils.SHIFT_JIS_CHARSET, "SJIS");
    }

    @TestCase
    public func testShortISO885911(): Unit {
        // båd
        doTest([UInt8(0x62), UInt8(0xe5), UInt8(0x64)], StandardCharsets.ISO_8859_1, "ISO8859_1");
    }

    @TestCase
    public func testShortUTF81(): Unit {
        // Español
        doTest(
            [
                UInt8(0x45),
                UInt8(0x73),
                UInt8(0x70),
                UInt8(0x61),
                UInt8(0xc3),
                UInt8(0xb1),
                UInt8(0x6f),
                UInt8(0x6c)
            ],
            StandardCharsets.UTF_8,
            "UTF-8"
        );
    }

    @TestCase
    public func testMixedShiftJIS1(): Unit {
        // Hello 金!
        doTest(
            [
                UInt8(0x48),
                UInt8(0x65),
                UInt8(0x6c),
                UInt8(0x6c),
                UInt8(0x6f),
                UInt8(0x20),
                UInt8(0x8b),
                UInt8(0xe0),
                UInt8(0x21)
            ],
            StringUtils.SHIFT_JIS_CHARSET,
            "SJIS"
        );
    }

    @TestCase
    public func testUTF16BE(): Unit {
        // 调压柜
        let CURRENT_ENDIAN: Endian = getCurrentEndian()
        match (CURRENT_ENDIAN) {
            case Endian.Big => doTest(
                [
                    UInt8(0xFE),
                    UInt8(0xFF),
                    UInt8(0x8c),
                    UInt8(0x03),
                    UInt8(0x53),
                    UInt8(0x8b),
                    UInt8(0x67),
                    UInt8(0xdc)
                ],
                StandardCharsets.UTF_16BE,
                StandardCharsets.UTF_16BE.name()
            );
            case _ => doTest(
                [
                    UInt8(0xFE),
                    UInt8(0xFF),
                    UInt8(0x8c),
                    UInt8(0x03),
                    UInt8(0x53),
                    UInt8(0x8b),
                    UInt8(0x67),
                    UInt8(0xdc)
                ],
                StandardCharsets.UTF_16LE,
                StandardCharsets.UTF_16LE.name()
            );
        }
    }

    @TestCase
    public func testUTF16LE(): Unit {
        // 调压柜
        let CURRENT_ENDIAN: Endian = getCurrentEndian()
        match (CURRENT_ENDIAN) {
            case Endian.Big => doTest(
                [
                    UInt8(0xFF),
                    UInt8(0xFE),
                    UInt8(0x03),
                    UInt8(0x8c),
                    UInt8(0x8b),
                    UInt8(0x53),
                    UInt8(0xdc),
                    UInt8(0x67)
                ],
                StandardCharsets.UTF_16BE,
                StandardCharsets.UTF_16BE.name()
            );
            case _ => doTest(
                [
                    UInt8(0xFF),
                    UInt8(0xFE),
                    UInt8(0x03),
                    UInt8(0x8c),
                    UInt8(0x8b),
                    UInt8(0x53),
                    UInt8(0xdc),
                    UInt8(0x67)
                ],
                StandardCharsets.UTF_16LE,
                StandardCharsets.UTF_16LE.name()
            );
        }
    }

    private static func doTest(bytes: Array<UInt8>, charset: MyCharset, encoding: String) {
        var guessedCharset: MyCharset = StringUtils.guessCharset(bytes, HashMap<DecodeHintType, Any>());
        var guessedEncoding: String = StringUtils.guessEncoding(bytes, HashMap<DecodeHintType, Any>());
        @Assert(charset, guessedCharset)
        @Assert(encoding, guessedEncoding)
    }
}
